{
  "groups": [
    {
      "name": "ellipsis",
      "description": "Replaces ... and \u2026 with word-joiner-separated dots",
      "cases": [
        { "desc": "three dots", "input": "wait...", "expected": "wait\u2060.\u2060.\u2060.\u2060", "lang": "en" },
        { "desc": "unicode ellipsis", "input": "wait\u2026", "expected": "wait\u2060.\u2060.\u2060.\u2060", "lang": "en" }
      ]
    },
    {
      "name": "nbsp",
      "description": "Inserts non-breaking spaces after short words and between numbers and words (initials: see the initials group)",
      "cases": [
        { "desc": "number followed by word", "input": "5 meters", "expected": "5\u00A0meters", "lang": "en" },
        { "desc": "short word at end of phrase", "input": "it is a test", "expected": "it is a\u00A0test", "lang": "en" },
        { "desc": "short word followed by comma still glues to next word", "input": "for, then again", "expected": "for,\u00A0then again", "lang": "en" }
      ]
    },
    {
      "name": "number-nbsp-word",
      "description": "placeNumberNbspWord glues only a single regular space after a number that ends in a digit: to U+00A0 before a word, to U+202F before a % that is a unit (the % stays where the author put it). Newlines, repeated spaces, other space characters and numbers with trailing punctuation are left alone, and so is a % followed by a number or glued to a word (modulo, format specifiers)",
      "cases": [
        { "desc": "decimal number", "input": "3.5 kg", "expected": "3.5\u00A0kg", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "digit group: only the last space glues", "input": "1 000 km", "expected": "1 000\u00A0km", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "Russian", "input": "5 января", "expected": "5\u00A0января", "lang": "ru", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "Korean counter", "input": "3 개", "expected": "3\u00A0개", "lang": "ko", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "Japanese", "input": "5 メートル", "expected": "5\u00A0メートル", "lang": "ja", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "no language: language-free rule still applies", "input": "5 meters", "expected": "5\u00A0meters", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "already no-break space", "input": "5\u00A0meters", "expected": "5\u00A0meters", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "newline is left alone", "input": "5\nmeters", "expected": "5\nmeters", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "paragraph break is left alone", "input": "5\n\nmeters", "expected": "5\n\nmeters", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "CRLF is left alone", "input": "5\r\nmeters", "expected": "5\r\nmeters", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "repeated spaces are not collapsed", "input": "5  meters", "expected": "5  meters", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "tab is left alone", "input": "5\tmeters", "expected": "5\tmeters", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "narrow no-break space is left alone", "input": "5\u202Fkm", "expected": "5\u202Fkm", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "hair space is left alone", "input": "5\u200Ameters", "expected": "5\u200Ameters", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "thin space is left alone", "input": "5\u2009km", "expected": "5\u2009km", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "ideographic space is left alone", "input": "5\u3000メートル", "expected": "5\u3000メートル", "lang": "ja", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "number with trailing period (sentence end) is left alone", "input": "in 2024. We", "expected": "in 2024. We", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "number with trailing comma is left alone", "input": "5, then", "expected": "5, then", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "decimal then sentence end is left alone", "input": "5.5. Then", "expected": "5.5. Then", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "piece boundary after the space declines", "segments": ["5 ", "meters"], "expected": ["5 ", "meters"], "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "percent: a spaced % gets a narrow no-break space", "input": "50 %", "expected": "50\u202f%", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "percent: decimal number", "input": "3.5 %", "expected": "3.5\u202f%", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "percent: sentence-final", "input": "up 50 %.", "expected": "up 50\u202f%.", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "percent: before a closing bracket", "input": "(50 %)", "expected": "(50\u202f%)", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "percent: a tight % is left alone, nothing is inserted or moved", "input": "50%", "expected": "50%", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "percent: no-break space is left alone", "input": "50\u00a0%", "expected": "50\u00a0%", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "percent: narrow no-break space is already formatted", "input": "50\u202f%", "expected": "50\u202f%", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "percent: repeated spaces are left alone", "input": "50  %", "expected": "50  %", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "percent: newline is left alone", "input": "50\n%", "expected": "50\n%", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "percent: number with trailing period is left alone", "input": "5. %", "expected": "5. %", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "percent: piece boundary after the space declines", "segments": ["50 ", "%"], "expected": ["50 ", "%"], "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "percent: a number after the % declines (modulo)", "input": "10 % 3", "expected": "10 % 3", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "percent: a tight number after the % declines", "input": "5 %5", "expected": "5 %5", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "percent: a tight word after the % declines (format specifier)", "input": "5 %d", "expected": "5 %d", "lang": "en", "rules": { "base": "none", "placeNumberNbspWord": true } },
        { "desc": "percent: a number behind a currency code after the % declines on both passes", "input": "5 % 3 USD", "expected": "5 % $\u202f3", "lang": "en" },
        { "desc": "percent: a tight word that another rule rewrites declines on both passes", "input": "5 %No. 4", "expected": "5 %\u2116\u202f4", "lang": "en" },
        { "desc": "percent: every rule on", "input": "50 % of respondents", "expected": "50\u202f% of\u00a0respondents", "lang": "en" },
        { "desc": "percent: math zone keeps the hair spaces of the operators", "input": "x = 50 %", "expected": "x\u200a=\u200a50\u202f%", "lang": "en", "rules": { "base": "math" } }
      ]
    },
    {
      "name": "initials",
      "description": "An initial is one capital letter plus a period. Whitespace between initials becomes U+202F; whitespace before a following capitalized word becomes U+00A0. Whole words (Mr., Yes., AI.) are not initials, a lone I is skipped unless chained, and no spaces are ever inserted",
      "cases": [
        { "desc": "initial and surname", "input": "J. Smith", "expected": "J.\u00A0Smith", "lang": "en" },
        { "desc": "two initials", "input": "J. K. Smith", "expected": "J.\u202FK.\u00A0Smith", "lang": "en" },
        { "desc": "three initials", "input": "J. R. R. Tolkien", "expected": "J.\u202FR.\u202FR.\u00A0Tolkien", "lang": "en" },
        { "desc": "initials with no surname", "input": "J. K.", "expected": "J.\u202FK.", "lang": "en" },
        { "desc": "lowercase after the last initial stays", "input": "J. K. smith", "expected": "J.\u202FK. smith", "lang": "en" },
        { "desc": "lowercase after a lone initial stays", "input": "J. smith", "expected": "J. smith", "lang": "en" },
        { "desc": "no space between initials: nothing is inserted", "input": "J.K.Rowling", "expected": "J.K.Rowling", "lang": "en" },
        { "desc": "tight chain then spaced surname", "input": "J.K. Rowling", "expected": "J.K.\u00A0Rowling", "lang": "en" },
        { "desc": "short-word initial is not pre-empted by placeNbsp", "input": "A. Smith", "expected": "A.\u00A0Smith", "lang": "en" },
        { "desc": "short-word initials chain", "input": "A. A. Milne", "expected": "A.\u202FA.\u00A0Milne", "lang": "en" },
        { "desc": "accented capital", "input": "\u00C9. Zola", "expected": "\u00C9.\u00A0Zola", "lang": "en" },
        { "desc": "after an opening bracket", "input": "(J. Smith)", "expected": "(J.\u00A0Smith)", "lang": "en" },
        { "desc": "newline between initial and surname becomes no-break space", "input": "J.\nSmith", "expected": "J.\u00A0Smith", "lang": "en", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "shortcode that expands to a capital letter", "input": "\\Pi. Smith", "expected": "\u03A0.\u00A0Smith", "lang": "en" },
        { "desc": "shortcode merged into a longer word is not an initial", "input": "J\\alpha. Smith", "expected": "J\u03B1. Smith", "lang": "en", "rules": { "base": "none", "placeGreekSymbols": true, "formatInitials": true } },
        { "desc": "two-letter abbreviation (only this rule)", "input": "Ph.D. students", "expected": "Ph.D. students", "lang": "en", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "dotted acronym (only this rule)", "input": "the U.S. economy", "expected": "the U.S. economy", "lang": "en", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "honorific (only this rule)", "input": "Mr. Smith", "expected": "Mr. Smith", "lang": "en", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "short sentence-final word (only this rule)", "input": "Yes. And then", "expected": "Yes. And then", "lang": "en", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "capitalized two-letter word before a period (only this rule)", "input": "I use AI. Then we", "expected": "I use AI. Then we", "lang": "en", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "paragraph break after a short word (only this rule)", "input": "Hi.\n\nHow are you", "expected": "Hi.\n\nHow are you", "lang": "en", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "pronoun I at sentence end (only this rule)", "input": "So did I. Then we left.", "expected": "So did I. Then we left.", "lang": "en", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "lone I before a surname (only this rule)", "input": "I. Smith", "expected": "I. Smith", "lang": "en", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "I starting a chain", "input": "I. M. Pei", "expected": "I.\u202FM.\u00A0Pei", "lang": "en" },
        { "desc": "I ending a chain", "input": "X. I. Smith", "expected": "X.\u202FI.\u00A0Smith", "lang": "en" },
        { "desc": "I after a sentence end is not chained (only this rule)", "input": "Wait. I. Smith", "expected": "Wait. I. Smith", "lang": "en", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "ellipsis token is not a period (only this rule)", "input": "J... Smith", "expected": "J... Smith", "lang": "en", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "double period is not a period (only this rule)", "input": "J.. Smith", "expected": "J.. Smith", "lang": "en", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "number after an initial (only this rule)", "input": "J. 5", "expected": "J. 5", "lang": "en", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "roman numeral is not an initial (only this rule)", "input": "Henry VIII. The", "expected": "Henry VIII. The", "lang": "en", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "Russian initials", "input": "А. С. Пушкин", "expected": "А.\u202FС.\u00A0Пушкин", "lang": "ru" },
        { "desc": "Russian initials, second poet", "input": "Н. А. Некрасов", "expected": "Н.\u202FА.\u00A0Некрасов", "lang": "ru" },
        { "desc": "Russian Yo initial", "input": "Ё. Иванов", "expected": "Ё.\u00A0Иванов", "lang": "ru" },
        { "desc": "Russian short sentence-final word (only this rule)", "input": "Да. Но", "expected": "Да. Но", "lang": "ru", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "Japanese: Latin initials, kana is not capitalized", "input": "J. K. ローリング", "expected": "J.\u202FK. ローリング", "lang": "ja" },
        { "desc": "Japanese: sentence-final AI (only this rule)", "input": "I like AI. 次に", "expected": "I like AI. 次に", "lang": "ja", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "Korean: sentence-final AI (only this rule)", "input": "저는 AI. 다음은", "expected": "저는 AI. 다음은", "lang": "ko", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "Korean: Latin initials, hangul is not capitalized", "input": "J. K. 롤링", "expected": "J.\u202FK. 롤링", "lang": "ko" },
        { "desc": "no language: language-free rule still applies", "input": "J. K. Smith", "expected": "J.\u202FK.\u00A0Smith" },
        { "desc": "piece boundary after the initial's space declines", "segments": ["J. ", "Smith"], "expected": ["J. ", "Smith"], "lang": "en", "rules": { "base": "none", "formatInitials": true } }
      ]
    }
  ]
}
