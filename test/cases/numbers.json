{
  "groups": [
    {
      "name": "multiplication-chain",
      "description": "Multiple x operators in a row \u2014 second x must still be processed after first is mutated",
      "cases": [
        { "desc": "triple multiplication", "input": "5 x 5 x 5", "expected": "5\u202F\u00D7\u202F5\u202F\u00D7\u202F5", "lang": "en" }
      ]
    },
    {
      "name": "multiplication-sign",
      "description": "An x, X or typed multiplication sign between two numbers: the glyph always becomes U+00D7, a single regular or no-break space on each side becomes U+202F (U+200A in a math zone), spaces are never inserted, and a tight 0x prefix is declined",
      "cases": [
        { "desc": "typed sign with spaces", "input": "3 \u00D7 4", "expected": "3\u202F\u00D7\u202F4", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "capital X", "input": "3 X 4", "expected": "3\u202F\u00D7\u202F4", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "tight letter becomes the sign, no spaces inserted", "input": "1920x1080", "expected": "1920\u00D71080", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "tight typed sign is left alone", "input": "3\u00D74", "expected": "3\u00D74", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "space only on the left", "input": "3 x4", "expected": "3\u202F\u00D74", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "no-break spaces become narrow", "input": "3\u00A0x\u00A04", "expected": "3\u202F\u00D7\u202F4", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "already formatted is unchanged", "input": "3\u202F\u00D7\u202F4", "expected": "3\u202F\u00D7\u202F4", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "hair spaces in prose are left alone", "input": "3\u200A\u00D7\u200A4", "expected": "3\u200A\u00D7\u200A4", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "repeated spaces are left alone", "input": "5   x   5", "expected": "5   \u00D7   5", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "newline before the operator is left alone", "input": "5\nx 5", "expected": "5\n\u00D7\u202F5", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "mixed letter and typed sign chain", "input": "5 x 5 \u00D7 5", "expected": "5\u202F\u00D7\u202F5\u202F\u00D7\u202F5", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "hex prefix is declined", "input": "0x10", "expected": "0x10", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "uppercase hex prefix is declined", "input": "0X1F", "expected": "0X1F", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "spaced zero is multiplied", "input": "0 x 10", "expected": "0\u202F\u00D7\u202F10", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "left number ending in a period is declined", "input": "3. x 4", "expected": "3. x 4", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "word on the left is declined", "input": "a x 4", "expected": "a x 4", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "word on the right is declined", "input": "3 \u00D7 b", "expected": "3 \u00D7 b", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "Cyrillic letter is not the operator", "input": "3 \u0445 4", "expected": "3 \u0445 4", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "math zone keeps hair spaces (letter)", "input": "3 x 4", "expected": "3\u200A\u00D7\u200A4", "lang": "en", "rules": { "base": "math", "placeMultiplicationSign": true } },
        { "desc": "math zone keeps hair spaces (typed sign)", "input": "3 \u00D7 4", "expected": "3\u200A\u00D7\u200A4", "lang": "en", "rules": { "base": "math", "placeMultiplicationSign": true } },
        { "desc": "with every rule on, number-nbsp-word does not win", "input": "3 x 4", "expected": "3\u202F\u00D7\u202F4", "lang": "en" },
        { "desc": "with every rule on, percent moves and the product is still found", "input": "5% x 3", "expected": "%\u202F5\u202F\u00D7\u202F3", "lang": "en" }
      ]
    },
    {
      "name": "number-interactions",
      "description": "Number rules firing on the same token stream",
      "cases": [
        { "desc": "numero followed by ordinal", "input": "No. 1st", "expected": "\u2116\u202F1\u02E2\u1D57", "lang": "en" },
        { "desc": "temperature and percent in same string", "input": "100oC at 50%", "expected": "100\u202F\u00B0C at\u00A0%\u202F50", "lang": "en" }
      ]
    },
    {
      "name": "ordinals",
      "description": "Converts ordinal suffixes to superscript",
      "cases": [
        { "desc": "1st", "input": "1st", "expected": "1\u02E2\u1D57", "lang": "en" },
        { "desc": "2nd", "input": "2nd", "expected": "2\u207F\u1D48", "lang": "en" },
        { "desc": "3rd", "input": "3rd", "expected": "3\u02B3\u1D48", "lang": "en" },
        { "desc": "4th", "input": "4th", "expected": "4\u1D57\u02B0", "lang": "en" }
      ]
    },
    {
      "name": "fractions",
      "description": "Replaces / between two numbers with a fraction slash",
      "cases": [
        { "desc": "half", "input": "1/2", "expected": "1\u20442", "lang": "en" },
        { "desc": "three-quarter", "input": "3/4", "expected": "3\u20444", "lang": "en" }
      ]
    },
    {
      "name": "temperature",
      "description": "Formats temperature values with a narrow no-break space and degree sign",
      "cases": [
        { "desc": "Celsius", "input": "100oC", "expected": "100\u202F\u00B0C", "lang": "en" },
        { "desc": "Fahrenheit", "input": "72oF", "expected": "72\u202F\u00B0F", "lang": "en" },
        { "desc": "negative", "input": "-18oC", "expected": "\u221218\u202F\u00B0C", "lang": "en" }
      ]
    },
    {
      "name": "temperature-guards",
      "description": "The unit must follow a number ending in a digit and may be followed directly only by a Han, Kana or Hangul letter; a capital after the degree sign is not an initial",
      "cases": [
        { "desc": "sentence-final temperature is not read as an initial", "input": "It was 20oC. Then we left.", "expected": "It was 20\u202F\u00B0C. Then we left.", "lang": "en" },
        { "desc": "a capital after a degree sign is not an initial (only this rule)", "input": "20\u202F\u00B0C. Then", "expected": "20\u202F\u00B0C. Then", "lang": "en", "rules": { "base": "none", "formatInitials": true } },
        { "desc": "number ending in a period is not a temperature", "input": "5.oC", "expected": "5.oC", "lang": "en" },
        { "desc": "Latin letter after the unit is not a temperature", "input": "20oCa", "expected": "20oCa", "lang": "en" },
        { "desc": "Cyrillic letter after the unit is not a temperature", "input": "20oC\u0432", "expected": "20oC\u0432", "lang": "ru" },
        { "desc": "Han letters after the unit", "input": "20oC以下", "expected": "20\u202F\u00B0C以下", "lang": "ja" },
        { "desc": "prolonged sound mark counts as Kana (needs script extensions)", "input": "20oC\u30FC", "expected": "20\u202F\u00B0C\u30FC", "lang": "ja" }
      ]
    },
    {
      "name": "percent",
      "description": "Places % sign before the number with a narrow no-break space",
      "cases": [
        { "desc": "percent after number", "input": "50%", "expected": "%\u202F50", "lang": "en" },
        { "desc": "percent after 100", "input": "100%", "expected": "%\u202F100", "lang": "en" },
        { "desc": "leading percent before a number also gets the narrow space", "input": "%50", "expected": "%\u202F50", "lang": "en", "rules": { "base": "none", "placePercentSign": true } }
      ]
    },
    {
      "name": "currency",
      "description": "Places currency symbol before the number with a narrow no-break space; converts ISO codes",
      "cases": [
        { "desc": "symbol before number", "input": "$100", "expected": "$\u202F100", "lang": "en" },
        { "desc": "ISO code before number", "input": "USD 100", "expected": "$\u202F100", "lang": "en" },
        { "desc": "number then ISO code", "input": "100 USD", "expected": "$\u202F100", "lang": "en" },
        { "desc": "euro symbol", "input": "\u20AC200", "expected": "\u20AC\u202F200", "lang": "en" }
      ]
    }
  ]
}
