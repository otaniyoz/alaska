{
  "groups": [
    {
      "name": "lang",
      "description": "lang matches on the primary subtag, case-insensitive; unsupported or missing languages leave quotes, apostrophes and short words untouched",
      "cases": [
        { "desc": "en-US is English", "input": "\"hello\"", "expected": "\u2018\u2060hello\u2060\u2019", "lang": "en-US" },
        { "desc": "uppercase EN is English", "input": "\"hello\"", "expected": "\u2018\u2060hello\u2060\u2019", "lang": "EN" },
        { "desc": "ru-RU is Russian", "input": "\"hello\"", "expected": "\u00AB\u2060hello\u2060\u00BB", "lang": "ru-RU" },
        { "desc": "en-US gets the English short-word list", "input": "it is a test", "expected": "it is a\u00A0test", "lang": "en-US" },
        { "desc": "unsupported language leaves quotes", "input": "\"hello\"", "expected": "\"hello\"", "lang": "de" },
        { "desc": "unsupported language leaves apostrophe", "input": "it's", "expected": "it's", "lang": "fr" },
        { "desc": "unsupported language gets no short-word nbsp", "input": "it is a test", "expected": "it is a test", "lang": "de" },
        { "desc": "unsupported language still gets language-free rules", "input": "5 meters", "expected": "5\u00A0meters", "lang": "de" },
        { "desc": "missing lang leaves quotes", "input": "\"hello\"", "expected": "\"hello\"" },
        { "desc": "missing lang leaves apostrophe", "input": "it's", "expected": "it's" },
        { "desc": "empty lang leaves quotes", "input": "\"hello\"", "expected": "\"hello\"", "lang": "" },
        { "desc": "underscore tag is not matched", "input": "\"hello\"", "expected": "\"hello\"", "lang": "en_US" },
        { "desc": "english-like word is not matched", "input": "\"hello\"", "expected": "\"hello\"", "lang": "english" },
        { "desc": "object property name as lang does not throw", "input": "it is a test", "expected": "it is a test", "lang": "constructor" },
        { "desc": "__proto__ as lang does not throw", "input": "it is a test", "expected": "it is a test", "lang": "__proto__" }
      ]
    },
    {
      "name": "russian",
      "description": "Russian-specific rules: em-dash, non-breaking spaces after short words, guillemet quotes",
      "cases": [
        { "desc": "spaced hyphen becomes em-dash", "input": "\u0430 - \u0431", "expected": "\u0430\u00A0\u2014 \u0431", "lang": "ru" },
        { "desc": "nbsp after short preposition", "input": "\u044F \u0432 \u0434\u043E\u043C\u0435", "expected": "\u044F \u0432\u00A0\u0434\u043E\u043C\u0435", "lang": "ru" },
        { "desc": "outer guillemet quotes", "input": "\"\u043F\u0440\u0438\u0432\u0435\u0442\"", "expected": "\u00AB\u2060\u043F\u0440\u0438\u0432\u0435\u0442\u2060\u00BB", "lang": "ru" },
        { "desc": "nested quotes use lower-9 style", "input": "\"\u0442\u0435\u043A\u0441\u0442 '\u0432\u043D\u0443\u0442\u0440\u044C'\"", "expected": "\u00AB\u2060\u0442\u0435\u043A\u0441\u0442 \u201E\u2060\u0432\u043D\u0443\u0442\u0440\u044C\u2060\u201C\u2060\u00BB", "lang": "ru" },
        { "desc": "short conjunction followed by comma still glues to next word", "input": "и, возможно, дома", "expected": "и,\u00A0возможно, дома", "lang": "ru" }
      ]
    },
    {
      "name": "japanese",
      "description": "ja is unsupported: language-dependent rules (quotes, apostrophes, short words) stay off and language-free rules still apply. Pins the current state; these cases change on purpose when support lands",
      "cases": [
        { "desc": "straight quotes are left as written", "input": "\"こんにちは\"", "expected": "\"こんにちは\"", "lang": "ja" },
        { "desc": "apostrophe is left as written", "input": "it's", "expected": "it's", "lang": "ja" },
        { "desc": "no short-word nbsp", "input": "it is a test", "expected": "it is a test", "lang": "ja" }
      ]
    },
    {
      "name": "korean",
      "description": "ko is unsupported: language-dependent rules (quotes, apostrophes, short words) stay off and language-free rules still apply. Pins the current state; these cases change on purpose when support lands",
      "cases": [
        { "desc": "straight quotes are left as written", "input": "\"안녕하세요\"", "expected": "\"안녕하세요\"", "lang": "ko" },
        { "desc": "apostrophe is left as written", "input": "it's", "expected": "it's", "lang": "ko" },
        { "desc": "no short-word nbsp", "input": "it is a test", "expected": "it is a test", "lang": "ko" }
      ]
    }
  ]
}
