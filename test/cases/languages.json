{
  "groups": [
    {
      "name": "lang",
      "description": "lang matches on the primary subtag, case-insensitive; unsupported or missing languages leave quotes, apostrophes and short words untouched",
      "cases": [
        { "desc": "en-US is English, with American quote nesting", "input": "\"hello\"", "expected": "\u201Chello\u201D", "lang": "en-US" },
        { "desc": "uppercase EN is English", "input": "\"hello\"", "expected": "\u2018hello\u2019", "lang": "EN" },
        { "desc": "ru-RU is Russian", "input": "\"hello\"", "expected": "\u00ABhello\u00BB", "lang": "ru-RU" },
        { "desc": "en-US gets the English short-word list", "input": "it is a test", "expected": "it is a\u00A0test", "lang": "en-US" },
        { "desc": "unsupported language leaves quotes", "input": "\"hello\"", "expected": "\"hello\"", "lang": "de" },
        { "desc": "unsupported language leaves apostrophe", "input": "it's", "expected": "it's", "lang": "fr" },
        { "desc": "unsupported language gets no short-word nbsp", "input": "it is a test", "expected": "it is a test", "lang": "de" },
        { "desc": "unsupported language still gets language-free rules", "input": "5 meters", "expected": "5\u00A0meters", "lang": "de" },
        { "desc": "missing lang leaves quotes", "input": "\"hello\"", "expected": "\"hello\"" },
        { "desc": "missing lang leaves apostrophe", "input": "it's", "expected": "it's" },
        { "desc": "empty lang leaves quotes", "input": "\"hello\"", "expected": "\"hello\"", "lang": "" },
        { "desc": "underscore tag is not matched", "input": "\"hello\"", "expected": "\"hello\"", "lang": "en_US" },
        { "desc": "english-like word is not matched", "input": "\"hello\"", "expected": "\"hello\"", "lang": "english" },
        { "desc": "object property name as lang does not throw", "input": "it is a test", "expected": "it is a test", "lang": "constructor" },
        { "desc": "__proto__ as lang does not throw", "input": "it is a test", "expected": "it is a test", "lang": "__proto__" }
      ]
    },
    {
      "name": "russian",
      "description": "Russian-specific rules: em-dash, non-breaking spaces after short words, guillemet quotes",
      "cases": [
        { "desc": "spaced hyphen becomes em-dash", "input": "\u0430 - \u0431", "expected": "\u0430\u00A0\u2014 \u0431", "lang": "ru" },
        { "desc": "nbsp after short preposition", "input": "\u044F \u0432 \u0434\u043E\u043C\u0435", "expected": "\u044F \u0432\u00A0\u0434\u043E\u043C\u0435", "lang": "ru" },
        { "desc": "outer guillemet quotes", "input": "\"\u043F\u0440\u0438\u0432\u0435\u0442\"", "expected": "\u00AB\u043F\u0440\u0438\u0432\u0435\u0442\u00BB", "lang": "ru" },
        { "desc": "nested quotes use lower-9 style", "input": "\"\u0442\u0435\u043A\u0441\u0442 '\u0432\u043D\u0443\u0442\u0440\u044C'\"", "expected": "\u00AB\u0442\u0435\u043A\u0441\u0442 \u201E\u0432\u043D\u0443\u0442\u0440\u044C\u201C\u00BB", "lang": "ru" },
        { "desc": "short conjunction followed by comma still glues to next word", "input": "и, возможно, дома", "expected": "и,\u00A0возможно, дома", "lang": "ru" },
        { "desc": "minus after an opening guillemet", "input": "\u00AB-5\u00BB", "expected": "\u00AB\u22125\u00BB", "lang": "ru" },
        { "desc": "minus after a nested low-9 opening quote", "input": "\"\u0442\u0435\u043A\u0441\u0442 '-5'\"", "expected": "\u00AB\u0442\u0435\u043A\u0441\u0442 \u201E\u22125\u201C\u00BB", "lang": "ru" }
      ]
    },
    {
      "name": "english-regions",
      "description": "en picks single outer quotes unless the first two-letter alphabetic subtag after the primary one (up to a singleton) is US or CA, which pick double outer quotes; case-insensitive; script, numeric region and private-use subtags do not count",
      "cases": [
        { "desc": "en-US nests single inside double", "input": "\"x 'y'\"", "expected": "\u201Cx \u2018y\u2019\u201D", "lang": "en-US" },
        { "desc": "en-CA nests single inside double", "input": "\"x 'y'\"", "expected": "\u201Cx \u2018y\u2019\u201D", "lang": "en-CA" },
        { "desc": "script subtag is skipped", "input": "\"x 'y'\"", "expected": "\u201Cx \u2018y\u2019\u201D", "lang": "en-Latn-US" },
        { "desc": "region is case-insensitive", "input": "\"x 'y'\"", "expected": "\u201Cx \u2018y\u2019\u201D", "lang": "EN-us" },
        { "desc": "region before a variant or extension still counts", "input": "\"x 'y'\"", "expected": "\u201Cx \u2018y\u2019\u201D", "lang": "en-US-x-foo" },
        { "desc": "private use subtag is not a region", "input": "\"x 'y'\"", "expected": "\u2018x \u201Cy\u201D\u2019", "lang": "en-x-us" },
        { "desc": "extension singleton stops the search", "input": "\"x 'y'\"", "expected": "\u2018x \u201Cy\u201D\u2019", "lang": "en-u-us" },
        { "desc": "en-GB nests double inside single", "input": "\"x 'y'\"", "expected": "\u2018x \u201Cy\u201D\u2019", "lang": "en-GB" },
        { "desc": "numeric region is single", "input": "\"x 'y'\"", "expected": "\u2018x \u201Cy\u201D\u2019", "lang": "en-419" },
        { "desc": "region on a non-English tag does not matter", "input": "\"hello\"", "expected": "\"hello\"", "lang": "de-US" },
        { "desc": "an en-US opener is closed as en-US in an en segment", "segments": ["\"x ", "y\""], "expected": ["\u201Cx ", "y\u201D"], "lang": "en", "langs": ["en-US", "en"] },
        { "desc": "an en opener is closed as en in an en-US segment", "segments": ["\"x ", "y\""], "expected": ["\u2018x ", "y\u2019"], "lang": "en", "langs": ["en", "en-US"] }
      ]
    },
    {
      "name": "japanese",
      "description": "ja is unsupported: language-dependent rules (quotes, apostrophes, short words) stay off and language-free rules still apply. Pins the current state; these cases change on purpose when support lands",
      "cases": [
        { "desc": "straight quotes are left as written", "input": "\"こんにちは\"", "expected": "\"こんにちは\"", "lang": "ja" },
        { "desc": "apostrophe is left as written", "input": "it's", "expected": "it's", "lang": "ja" },
        { "desc": "no short-word nbsp", "input": "it is a test", "expected": "it is a test", "lang": "ja" },
        { "desc": "minus after a straight quote: the quote stays, the minus is formatted", "input": "\"-5\"", "expected": "\"\u22125\"", "lang": "ja" }
      ]
    },
    {
      "name": "korean",
      "description": "ko gets typographic quotes only (double outer, single inner, like en-US); short-word nbsp and the other language-dependent rules stay off, and language-free rules still apply. Pins the current state; these cases change on purpose when full support lands",
      "cases": [
        { "desc": "double quotes become American-style double quotes", "input": "\"안녕하세요\"", "expected": "\u201C안녕하세요\u201D", "lang": "ko" },
        { "desc": "nested quotes alternate, double outer and single inner", "input": "\"그는 '좋아'라고 말했다\"", "expected": "\u201C그는 \u2018좋아\u2019라고 말했다\u201D", "lang": "ko" },
        { "desc": "single quotes around Hangul are quotes at the outer level, so they become double (documented)", "input": "그는 '좋아'라고 말했다", "expected": "그는 \u201C좋아\u201D라고 말했다", "lang": "ko" },
        { "desc": "ko-KR is Korean", "input": "\"안녕\"", "expected": "\u201C안녕\u201D", "lang": "ko-KR" },
        { "desc": "apostrophe between Latin letters is converted", "input": "it's", "expected": "it\u2019s", "lang": "ko" },
        { "desc": "no short-word nbsp", "input": "it is a test", "expected": "it is a test", "lang": "ko" },
        { "desc": "minus after an opening quote", "input": "\"-5\"", "expected": "\u201C\u22125\u201D", "lang": "ko" }
      ]
    }
  ]
}
