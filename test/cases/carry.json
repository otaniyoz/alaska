{
  "groups": [
    {
      "name": "carry",
      "description": "segments are formatted in order with one carry, then the outputs are reformatted with a fresh carry and must not change; langs overrides lang per segment",
      "cases": [
        { "desc": "closing quote after an inline element", "segments": ["\"Hello ", "x", "\""], "expected": ["\u2018Hello ", "x", "\u2019"], "lang": "en", "rules": { "base": "none", "placeTypographicQuotes": true } },
        { "desc": "two pairs across an empty segment", "segments": ["\"a\" ", "", "\"b\""], "expected": ["\u2018a\u2019 ", "", "\u2018b\u2019"], "lang": "en", "rules": { "base": "none", "placeTypographicQuotes": true } },
        { "desc": "nesting across three segments", "segments": ["\"a ", "'b ", "c' d\""], "expected": ["\u2018a ", "\u201Cb ", "c\u201D d\u2019"], "lang": "en", "rules": { "base": "none", "placeTypographicQuotes": true } },
        { "desc": "apostrophe after a segment boundary", "segments": ["it", "'s"], "expected": ["it", "\u2019s"], "lang": "en", "rules": { "base": "none", "placeTypographicQuotes": true } },
        { "desc": "opener in ru closes as ru in an en segment", "segments": ["\"мир", " hello\""], "expected": ["\u00ABмир", " hello\u00BB"], "lang": "en", "langs": ["ru", "en"], "rules": { "base": "none", "placeTypographicQuotes": true } },
        { "desc": "unsupported-lang segment mid-quote leaves the stack intact", "segments": ["\"a ", "'x' ", "b\""], "expected": ["\u2018a ", "'x' ", "b\u2019"], "lang": "en", "langs": ["en", "de", "en"], "rules": { "base": "none", "placeTypographicQuotes": true } },
        { "desc": "minus after whitespace in the previous segment", "segments": ["x ", "-5"], "expected": ["x ", "\u22125"], "lang": "en", "rules": { "base": "none", "placeMinusSign": true } },
        { "desc": "minus after a word in the previous segment stays", "segments": ["x", "-5"], "expected": ["x", "-5"], "lang": "en", "rules": { "base": "none", "placeMinusSign": true } },
        { "desc": "minus after an opening bracket in the previous segment", "segments": ["(", "-5"], "expected": ["(", "\u22125"], "lang": "en", "rules": { "base": "none", "placeMinusSign": true } },
        { "desc": "quote run at the start of a segment looks past it to the previous segment", "segments": ["x ", "\"-5"], "expected": ["x ", "\u2018\u22125"], "lang": "en", "rules": { "base": "none", "placeTypographicQuotes": true, "placeMinusSign": true } },
        { "desc": "zone operator in the previous segment is a lead", "segments": ["x=", "-5"], "expected": ["x=", "\u22125"], "lang": "en", "rules": { "base": "math" } },
        { "desc": "line-start dash after a newline in the previous segment", "segments": ["a\n", "- b"], "expected": ["a\n", "\u2014 b"], "lang": "en", "rules": { "base": "none", "placeEmdash": true } },
        { "desc": "dash after a word in the previous segment stays", "segments": ["a", "- b"], "expected": ["a", "- b"], "lang": "en", "rules": { "base": "none", "placeEmdash": true } },
        { "desc": "numeric range: a word at the end of the previous segment declines", "segments": ["x", "86-64"], "expected": ["x", "86-64"], "lang": "en", "rules": { "base": "none", "placeNumericRange": true } },
        { "desc": "numeric range: a hyphen at the end of the previous segment declines", "segments": ["1-", "2-3"], "expected": ["1-", "2-3"], "lang": "en", "rules": { "base": "none", "placeNumericRange": true } },
        { "desc": "numeric range: whitespace at the end of the previous segment allows", "segments": ["pp. ", "10-20"], "expected": ["pp. ", "10\u2060\u2013\u206020"], "lang": "en", "rules": { "base": "none", "placeNumericRange": true } },
        { "desc": "a double hyphen at the end of a piece is left alone, so the minus in the next piece has no lead", "segments": ["a --", "-5"], "expected": ["a --", "-5"], "lang": "en", "rules": { "base": "none", "placeEmdash": true, "placeMinusSign": true } }
      ]
    }
  ]
}
