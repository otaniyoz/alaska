{
  "groups": [
    {
      "name": "math-shortcodes",
      "description": "Expands backslash shortcodes to Unicode math symbols. Names follow LaTeX or unicode-math where one exists. Representatives only: the table in src/core.js (mathShortcodes) is the source of truth",
      "cases": [
        { "desc": "plus-minus", "input": "\\pm", "expected": "\u00B1", "lang": "en" },
        { "desc": "infinity", "input": "\\infty", "expected": "\u221E", "lang": "en" },
        { "desc": "times", "input": "\\times", "expected": "\u00D7", "lang": "en" },
        { "desc": "degree", "input": "\\degree", "expected": "\u00B0", "lang": "en" },
        { "desc": "less-or-equal and greater-or-equal give the slanted forms U+2A7D and U+2A7E, not U+2264 and U+2265 (undecided until ja support)", "input": "\\leq \\geq", "expected": "\u2A7D \u2A7E", "lang": "en" },
        { "desc": "triple and quadruple primes are typed as repeated primes", "input": "\\prime\\prime\\prime \\prime\\prime\\prime\\prime", "expected": "\u2032\u2032\u2032 \u2032\u2032\u2032\u2032", "lang": "en" },
        { "desc": "removed and renamed names stay as written", "input": "\\deg \\dia \\tprime \\qprime", "expected": "\\deg \\dia \\tprime \\qprime", "lang": "en" },
        { "desc": "not-equal", "input": "\\neq", "expected": "\u2260", "lang": "en" }
      ]
    },
    {
      "name": "greek-shortcodes",
      "description": "LaTeX-named Greek shortcodes; case-sensitive; \\epsilon and \\phi give the LaTeX forms (lunate U+03F5, stroked U+03D5); \\varepsilon and \\varphi give the letters U+03B5 and U+03C6, as in LaTeX and unicode-math. Representatives only: the table in src/core.js is the source of truth",
      "cases": [
        { "desc": "representatives: lowercase and uppercase", "input": "\\alpha \\pi \\Gamma \\Omega", "expected": "α π Γ Ω", "lang": "en" },
        { "desc": "epsilon and phi are the LaTeX forms (lunate epsilon, stroked phi)", "input": "\\epsilon \\phi", "expected": "\u03F5 \u03D5", "lang": "en" },
        { "desc": "var variants", "input": "\\varepsilon \\vartheta \\varkappa \\varpi \\varrho \\varsigma \\varphi \\digamma", "expected": "\u03B5 \u03D1 \u03F0 \u03D6 \u03F1 \u03C2 \u03C6 \u03DD", "lang": "en" },
        { "desc": "case matters", "input": "\\delta \\Delta", "expected": "\u03B4 \u0394", "lang": "en" },
        { "desc": "not LaTeX names stay as written", "input": "\\Alpha \\omicron \\Omicron", "expected": "\\Alpha \\omicron \\Omicron", "lang": "en" },
        { "desc": "unknown shortcode stays as written", "input": "\\Foo \\alphabet", "expected": "\\Foo \\alphabet", "lang": "en" },
        { "desc": "adjacent shortcodes", "input": "\\alpha\\beta", "expected": "\u03B1\u03B2", "lang": "en" },
        { "desc": "after a digit", "input": "2\\pi r", "expected": "2\u03C0 r", "lang": "en" },
        { "desc": "longest name wins over \\P", "input": "\\Pi \\P", "expected": "\u03A0 \u00B6", "lang": "en" },
        { "desc": "language independent", "input": "\\pi", "expected": "\u03C0", "lang": "de" },
        { "desc": "no language", "input": "\\pi", "expected": "\u03C0" }
      ]
    },
    {
      "name": "ornament-shortcodes",
      "description": "Ornamentation shortcodes follow LaTeX where a name exists; case-sensitive; \\dagger and \\ddagger were renamed to \\dag and \\ddag; \\section was removed: it is the LaTeX sectioning command and duplicated \\S; \\copyright is the LaTeX name, while \\registered, \\trademark and \\phonogram are deliberately short and differ from the LaTeX text commands \\textregistered, \\texttrademark and \\textcircledP; the ASCII forms (c), (tm), (r) and (p) are not converted",
      "cases": [
        { "desc": "section sign", "input": "\\S", "expected": "\u00A7", "lang": "en" },
        { "desc": "section sign with a number", "input": "\\S 5", "expected": "\u00A7 5", "lang": "en" },
        { "desc": "\\section is a LaTeX command, not a symbol: stays as written", "input": "\\section{Intro}", "expected": "\\section{Intro}", "lang": "en", "rules": { "base": "none", "placeTypographyOrnamentation": true } },
        { "desc": "paragraph sign", "input": "\\P", "expected": "\u00B6", "lang": "en" },
        { "desc": "dagger", "input": "\\dag", "expected": "\u2020", "lang": "en" },
        { "desc": "double dagger", "input": "\\ddag", "expected": "\u2021", "lang": "en" },
        { "desc": "bullet", "input": "\\bullet", "expected": "\u2022", "lang": "en" },
        { "desc": "shortcode ends at a digit", "input": "\\dag1", "expected": "\u20201", "lang": "en" },
        { "desc": "old dagger name is not recognised", "input": "\\dagger \\ddagger", "expected": "\\dagger \\ddagger", "lang": "en" },
        { "desc": "lowercase s and p are not section and paragraph", "input": "\\s \\p", "expected": "\\s \\p", "lang": "en" },
        { "desc": "copyright, registered, trademark and phonogram", "input": "\\copyright \\registered \\trademark \\phonogram", "expected": "\u00A9 \u00AE \u2122 \u2117", "lang": "en" },
        { "desc": "near-miss names stay as written", "input": "\\Copyright \\copyrights \\phonograms \\textregistered", "expected": "\\Copyright \\copyrights \\phonograms \\textregistered", "lang": "en" },
        { "desc": "ASCII forms are not converted", "input": "(c) (C) (tm) (TM) (r) (R) (p) (P)", "expected": "(c) (C) (tm) (TM) (r) (R) (p) (P)", "lang": "en" },
        { "desc": "dinkus and asterism", "input": "\\dinkus \\asterism", "expected": "\u2217\u2060\u2217\u2060\u2217 \u2042", "lang": "en" }
      ]
    },
    {
      "name": "emoticon-shortcodes",
      "description": "Emoticon shortcodes: every name expands, the characters are joined by U+2060 between each pair and not at either end; names are case-sensitive and end at the first character that is not an ASCII letter; language independent. The table in src/core.js (emoticonShortcodes) is the source of truth",
      "cases": [
        { "desc": "all eight names", "input": "\\shrug \\crying \\dying \\nervous \\cute \\happy \\surprised \\angry", "expected": "\u00AF\u2060\\\u2060_\u2060(\u2060\u30C4\u2060)\u2060_\u2060/\u2060\u00AF (\u2060\u22A4\u2060_\u2060\u22A4\u2060) (\u2060\u00D7\u2060_\u2060\u00D7\u2060) (\u2060-\u2060_\u2060-\u2060;\u2060) (\u2060^\u2060.\u2060^\u2060) (\u2060^\u2060_\u2060_\u2060_\u2060_\u2060_\u2060_\u2060_\u2060_\u2060_\u2060^\u2060) (\u2060\u00A0\u2060\u2D54\u2060.\u2060\u2D54\u2060\u00A0\u2060) (\u2060>\u2060_\u2060<\u2060)", "lang": "en" },
        { "desc": "all eight names in a math zone", "input": "\\shrug \\crying \\dying \\nervous \\cute \\happy \\surprised \\angry", "expected": "\u00AF\u2060\\\u2060_\u2060(\u2060\u30C4\u2060)\u2060_\u2060/\u2060\u00AF (\u2060\u22A4\u2060_\u2060\u22A4\u2060) (\u2060\u00D7\u2060_\u2060\u00D7\u2060) (\u2060-\u2060_\u2060-\u2060;\u2060) (\u2060^\u2060.\u2060^\u2060) (\u2060^\u2060_\u2060_\u2060_\u2060_\u2060_\u2060_\u2060_\u2060_\u2060_\u2060^\u2060) (\u2060\u00A0\u2060\u2D54\u2060.\u2060\u2D54\u2060\u00A0\u2060) (\u2060>\u2060_\u2060<\u2060)", "lang": "en", "rules": { "base": "math" } },
        { "desc": "Japanese text directly after the name", "input": "\\shrugです", "expected": "\u00AF\u2060\\\u2060_\u2060(\u2060\u30C4\u2060)\u2060_\u2060/\u2060\u00AFです", "lang": "ja" },
        { "desc": "Korean text directly after the name", "input": "\\crying입니다", "expected": "(\u2060\u22A4\u2060_\u2060\u22A4\u2060)입니다", "lang": "ko" },
        { "desc": "Cyrillic text directly after the name", "input": "\\shrugбла", "expected": "\u00AF\u2060\\\u2060_\u2060(\u2060\u30C4\u2060)\u2060_\u2060/\u2060\u00AFбла", "lang": "ru" },
        { "desc": "unknown and wrong-case names stay as written", "input": "\\shrugs \\Shrug", "expected": "\\shrugs \\Shrug", "lang": "en" },
        { "desc": "adjacent expansions", "input": "\\cute\\cute", "expected": "(\u2060^\u2060.\u2060^\u2060)(\u2060^\u2060.\u2060^\u2060)", "lang": "en" },
        { "desc": "a spaced hyphen before an emoticon is not an em dash", "input": "x - \\shrug", "expected": "x - \u00AF\u2060\\\u2060_\u2060(\u2060\u30C4\u2060)\u2060_\u2060/\u2060\u00AF", "lang": "en" },
        { "desc": "quoted emoticon", "input": "\"\\shrug\"", "expected": "\u2018\u00AF\u2060\\\u2060_\u2060(\u2060\u30C4\u2060)\u2060_\u2060/\u2060\u00AF\u2019", "lang": "en" }
      ]
    },
    {
      "name": "shape-shortcodes",
      "description": "Shape shortcodes: white shapes use the plain name, filled ones the black prefix; the suits are named *suit and follow the same pattern (so \\spadesuit and \\clubsuit are outlined, unlike LaTeX); U+FE0E follows the six glyphs platforms may draw as colour emoji; star, diamond, doublecircle and fisheye are the documented deviations, and star and diamond are operators in a math zone (see shape-math-variants). Other entries are table data (src/core.js shapeShortcodes is the source of truth)",
      "cases": [
        { "desc": "square", "input": "\\square", "expected": "\u25A1", "lang": "en" },
        { "desc": "blacksquare", "input": "\\blacksquare", "expected": "\u25A0", "lang": "en" },
        { "desc": "doublecircle", "input": "\\doublecircle", "expected": "\u25CE", "lang": "en" },
        { "desc": "fisheye", "input": "\\fisheye", "expected": "\u25C9", "lang": "en" },
        { "desc": "blacktriangleleft", "input": "\\blacktriangleleft", "expected": "\u25C0\uFE0E", "lang": "en" },
        { "desc": "blacktriangleright", "input": "\\blacktriangleright", "expected": "\u25B6\uFE0E", "lang": "en" },
        { "desc": "diamond", "input": "\\diamond", "expected": "\u25C7", "lang": "en" },
        { "desc": "star", "input": "\\star", "expected": "\u2606", "lang": "en" },
        { "desc": "heartsuit", "input": "\\heartsuit", "expected": "\u2661", "lang": "en" },
        { "desc": "spadesuit", "input": "\\spadesuit", "expected": "\u2664", "lang": "en" },
        { "desc": "clubsuit", "input": "\\clubsuit", "expected": "\u2667", "lang": "en" },
        { "desc": "diamondsuit", "input": "\\diamondsuit", "expected": "\u2662", "lang": "en" },
        { "desc": "blackheartsuit", "input": "\\blackheartsuit", "expected": "\u2665\uFE0E", "lang": "en" },
        { "desc": "blackspadesuit", "input": "\\blackspadesuit", "expected": "\u2660\uFE0E", "lang": "en" },
        { "desc": "blackclubsuit", "input": "\\blackclubsuit", "expected": "\u2663\uFE0E", "lang": "en" },
        { "desc": "blackdiamondsuit", "input": "\\blackdiamondsuit", "expected": "\u2666\uFE0E", "lang": "en" }
      ]
    },
    {
      "name": "shape-interactions",
      "description": "Shapes next to quotes, other shapes and near-miss names",
      "cases": [
        { "desc": "quoted shape", "input": "\"\\star\"", "expected": "\u2018\u2606\u2019", "lang": "en" },
        { "desc": "adjacent shapes", "input": "\\star\\star", "expected": "\u2606\u2606", "lang": "en" },
        { "desc": "different shapes adjacent", "input": "\\heartsuit\\blackheartsuit", "expected": "\u2661\u2665\uFE0E", "lang": "en" },
        { "desc": "prefix of a longer name is not expanded", "input": "\\squarex", "expected": "\\squarex", "lang": "en" },
        { "desc": "uppercase name is not recognised", "input": "\\STAR", "expected": "\\STAR", "lang": "en" },
        { "desc": "shortcode names are case-sensitive for the black variants", "input": "\\Blackstar", "expected": "\\Blackstar", "lang": "en" },
        { "desc": "triangle does not clash with triangleleft", "input": "\\triangle \\triangleleft", "expected": "\u25B3 \u25C1", "lang": "en" },
        { "desc": "removed suit and tainome names are no longer shortcodes", "input": "\\heart \\spade \\club \\blackheart \\blackspade \\blackclub \\tainome", "expected": "\\heart \\spade \\club \\blackheart \\blackspade \\blackclub \\tainome", "lang": "en" },
        { "desc": "language independent", "input": "\\square", "expected": "\u25A1", "lang": "de" },
        { "desc": "no language", "input": "\\square", "expected": "\u25A1" }
      ]
    },
    {
      "name": "shape-math-variants",
      "description": "\\star and \\diamond give the operators U+22C6 and U+22C4 when placeShapes and placeArithmeticalSymbols are both on (a math zone) and the glyphs U+2606 and U+25C7 otherwise; the filled variants do not change",
      "cases": [
        { "desc": "shapes and arithmetic on: operators", "input": "\\star \\diamond", "expected": "\u22C6 \u22C4", "lang": "en", "rules": { "base": "none", "placeShapes": true, "placeArithmeticalSymbols": true } },
        { "desc": "math zone: operators", "input": "\\star \\diamond", "expected": "\u22C6 \u22C4", "lang": "en", "rules": { "base": "math" } },
        { "desc": "shapes only: prose glyphs", "input": "\\star \\diamond", "expected": "\u2606 \u25C7", "lang": "en", "rules": { "base": "none", "placeShapes": true } },
        { "desc": "arithmetic only: shortcodes stay as written", "input": "\\star \\diamond", "expected": "\\star \\diamond", "lang": "en", "rules": { "base": "none", "placeArithmeticalSymbols": true } },
        { "desc": "math zone with shapes off: shortcodes stay as written", "input": "\\star \\diamond", "expected": "\\star \\diamond", "lang": "en", "rules": { "base": "math", "placeShapes": false } },
        { "desc": "math zone: filled variants are unchanged", "input": "\\blackstar \\blackdiamond", "expected": "\u2605 \u25C6", "lang": "en", "rules": { "base": "math" } },
        { "desc": "math zone: spaced hyphen before an operator is declined", "input": "x - \\star", "expected": "x - \u22C6", "lang": "en", "rules": { "base": "math" } }
      ]
    },
    {
      "name": "shortcode-isolation",
      "description": "Each shortcode category is gated only by its own flag, not by the others",
      "cases": [
        { "desc": "math shortcode ignored when only emoticons on", "input": "\\pm", "expected": "\\pm", "lang": "en", "rules": { "base": "none", "placeEmoticons": true } },
        { "desc": "emoticon ignored when only math on", "input": "\\shrug", "expected": "\\shrug", "lang": "en", "rules": { "base": "none", "placeMathematicalSymbols": true } },
        { "desc": "ornament ignored when only arrows on", "input": "\\dinkus", "expected": "\\dinkus", "lang": "en", "rules": { "base": "none", "placeArrows": true } },
        { "desc": "arrow shortcode ignored when only ornamentation on", "input": "\\arrn", "expected": "\\arrn", "lang": "en", "rules": { "base": "none", "placeTypographyOrnamentation": true } },
        { "desc": "greek ignored when every other shortcode category is on", "input": "\\alpha \\Omega", "expected": "\\alpha \\Omega", "lang": "en", "rules": { "base": "none", "placeMathematicalSymbols": true, "placeTypographyOrnamentation": true, "placeEmoticons": true, "placeArrows": true, "placeShapes": true } },
        { "desc": "former math greek shortcode ignored when only math on", "input": "\\pi", "expected": "\\pi", "lang": "en", "rules": { "base": "none", "placeMathematicalSymbols": true } },
        { "desc": "greek expands when only greek on", "input": "\\pi", "expected": "\u03C0", "lang": "en", "rules": { "base": "none", "placeGreekSymbols": true } },
        { "desc": "math ignored when only greek on", "input": "\\pm", "expected": "\\pm", "lang": "en", "rules": { "base": "none", "placeGreekSymbols": true } },
        { "desc": "degree expands when only math on", "input": "\\degree", "expected": "\u00B0", "lang": "en", "rules": { "base": "none", "placeMathematicalSymbols": true } },
        { "desc": "degree ignored when only ornamentation on", "input": "\\degree", "expected": "\\degree", "lang": "en", "rules": { "base": "none", "placeTypographyOrnamentation": true } },
        { "desc": "times expands when only math on", "input": "3 \\times 4", "expected": "3 \u00D7 4", "lang": "en", "rules": { "base": "none", "placeMathematicalSymbols": true } },
        { "desc": "times ignored when only multiplication on", "input": "3 \\times 4", "expected": "3 \\times 4", "lang": "en", "rules": { "base": "none", "placeMultiplicationSign": true } },
        { "desc": "section sign ignored when only greek on", "input": "\\S \\P", "expected": "\\S \\P", "lang": "en", "rules": { "base": "none", "placeGreekSymbols": true } },
        { "desc": "dag ignored when only math on", "input": "\\dag", "expected": "\\dag", "lang": "en", "rules": { "base": "none", "placeMathematicalSymbols": true } },
        { "desc": "east arrow ignored when only greek on", "input": "\\arre \\arrw", "expected": "\\arre \\arrw", "lang": "en", "rules": { "base": "none", "placeGreekSymbols": true } },
        { "desc": "east arrow expands when only arrows on", "input": "\\arre \\arrw", "expected": "\u2192 \u2190", "lang": "en", "rules": { "base": "none", "placeArrows": true } },
        { "desc": "both-way arrows ignored when only shapes on", "input": "\\arrwe \\arrns", "expected": "\\arrwe \\arrns", "lang": "en", "rules": { "base": "none", "placeShapes": true } },
        { "desc": "both-way arrows expand when only arrows on", "input": "\\arrwe \\arrns", "expected": "\u2194 \u2195", "lang": "en", "rules": { "base": "none", "placeArrows": true } },
        { "desc": "shape ignored when only ornamentation on", "input": "\\square", "expected": "\\square", "lang": "en", "rules": { "base": "none", "placeTypographyOrnamentation": true } },
        { "desc": "ornament ignored when only shapes on", "input": "\\dinkus", "expected": "\\dinkus", "lang": "en", "rules": { "base": "none", "placeShapes": true } },
        { "desc": "fisheye ignored when only ornamentation on", "input": "\\fisheye", "expected": "\\fisheye", "lang": "en", "rules": { "base": "none", "placeTypographyOrnamentation": true } },
        { "desc": "fisheye expands when only shapes on", "input": "\\fisheye", "expected": "\u25C9", "lang": "en", "rules": { "base": "none", "placeShapes": true } },
        { "desc": "shape ignored when only greek on", "input": "\\star", "expected": "\\star", "lang": "en", "rules": { "base": "none", "placeGreekSymbols": true } },
        { "desc": "copyright, registered, trademark and phonogram ignored when every other shortcode category is on", "input": "\\copyright \\registered \\trademark \\phonogram", "expected": "\\copyright \\registered \\trademark \\phonogram", "lang": "en", "rules": { "base": "none", "placeMathematicalSymbols": true, "placeGreekSymbols": true, "placeEmoticons": true, "placeArrows": true, "placeShapes": true } },
        { "desc": "copyright expands when only ornamentation on", "input": "\\copyright", "expected": "\u00A9", "lang": "en", "rules": { "base": "none", "placeTypographyOrnamentation": true } }
      ]
    },
    {
      "name": "numero",
      "description": "Replaces No. with the \u2116 sign",
      "cases": [
        { "desc": "No. with space before number", "input": "No. 1", "expected": "\u2116\u202F1", "lang": "en" },
        { "desc": "No. without space", "input": "No.1", "expected": "\u2116\u202F\u20601", "lang": "en" }
      ]
    },
    {
      "name": "arrows",
      "description": "ASCII arrow substitution and compass-direction shortcodes",
      "cases": [
        { "desc": "right arrow", "input": "item -> next", "expected": "item \u2192 next", "lang": "en" },
        { "desc": "left arrow", "input": "item <- next", "expected": "item \u2190 next", "lang": "en" },
        { "desc": "arrow wins over numeric-range hyphen", "input": "10->20", "expected": "10\u219220", "lang": "en" },
        { "desc": "arrow keeps surrounding multi-spaces", "input": "item  ->  next", "expected": "item  \u2192  next", "lang": "en" },
        { "desc": "north shortcode", "input": "\\arrn", "expected": "\u2191", "lang": "en" },
        { "desc": "south shortcode", "input": "\\arrs", "expected": "\u2193", "lang": "en" },
        { "desc": "northeast shortcode", "input": "\\arrne", "expected": "\u2197", "lang": "en" },
        { "desc": "southeast shortcode", "input": "\\arrse", "expected": "\u2198", "lang": "en" },
        { "desc": "southwest shortcode", "input": "\\arrsw", "expected": "\u2199", "lang": "en" },
        { "desc": "northwest shortcode", "input": "\\arrnw", "expected": "\u2196", "lang": "en" },
        { "desc": "east shortcode", "input": "\\arre", "expected": "\u2192", "lang": "en" },
        { "desc": "west shortcode", "input": "\\arrw", "expected": "\u2190", "lang": "en" },
        { "desc": "shortcodes next to each other", "input": "\\arrn\\arre\\arrs\\arrw", "expected": "\u2191\u2192\u2193\u2190", "lang": "en" },
        { "desc": "east does not clash with north-east", "input": "\\arre \\arrne", "expected": "\u2192 \u2197", "lang": "en" },
        { "desc": "both-way arrow", "input": "item <-> next", "expected": "item \u2194 next", "lang": "en" },
        { "desc": "both-way arrow wins over numeric-range hyphen", "input": "10<->20", "expected": "10\u219420", "lang": "en" },
        { "desc": "both-way arrow inside a longer run", "input": "<<->", "expected": "<\u2194", "lang": "en" },
        { "desc": "left arrow followed by a spaced greater-than is not both-way", "input": "<- >", "expected": "\u2190 >", "lang": "en" },
        { "desc": "west-east shortcode", "input": "\\arrwe", "expected": "\u2194", "lang": "en" },
        { "desc": "north-south shortcode", "input": "\\arrns", "expected": "\u2195", "lang": "en" },
        { "desc": "west-east does not clash with west", "input": "\\arrwe \\arrw", "expected": "\u2194 \u2190", "lang": "en" },
        { "desc": "old both-way names are no longer shortcodes", "input": "\\arrlr \\arrud", "expected": "\\arrlr \\arrud", "lang": "en", "rules": { "base": "none", "placeArrows": true } },
        { "desc": "ASCII long arrows are left alone", "input": "a --> b <-- c <--> d", "expected": "a --> b <-- c <--> d", "lang": "en", "rules": { "base": "none", "placeArrows": true, "placeEmdash": true } },
        { "desc": "<- tight before a number, currency sign or percent is not an arrow", "input": "x<-5 y<-$5 z<-5%", "expected": "x<-5 y<-$5 z<-5%", "lang": "en", "rules": { "base": "none", "placeArrows": true } },
        { "desc": "<- tight before a percent sign is not an arrow", "input": "x<-%5", "expected": "x<-%5", "lang": "en", "rules": { "base": "none", "placeArrows": true } },
        { "desc": "->> and <<- are left alone", "input": "a ->> b <<- c", "expected": "a ->> b <<- c", "lang": "en", "rules": { "base": "none", "placeArrows": true, "placeEmdash": true } },
        { "desc": "ja: <- before a number next to CJK is not an arrow", "input": "値<-5 です", "expected": "値<-5 です", "lang": "ja", "rules": { "base": "none", "placeArrows": true } },
        { "desc": "ko: <- before a number next to Hangul is not an arrow", "input": "값<-5 입니다", "expected": "값<-5 입니다", "lang": "ko", "rules": { "base": "none", "placeArrows": true } },
        { "desc": "ja: arrow between Latin letters", "input": "A->B です", "expected": "A\u2192B です", "lang": "ja", "rules": { "base": "none", "placeArrows": true } }
      ]
    }
  ]
}
