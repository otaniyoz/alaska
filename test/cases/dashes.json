{
  "groups": [
    {
      "name": "em-dash-guards",
      "description": "A spaced hyphen between a word and a number is an em dash; a dash after a newline is a line-start dash",
      "cases": [
        { "desc": "spaced hyphen between word and number is an em dash", "input": "value - 5", "expected": "value\u00A0\u2014 5", "lang": "en" },
        { "desc": "leading dash after newline", "input": "\n- item", "expected": "\n\u2014 item", "lang": "en" }
      ]
    },
    {
      "name": "em-dash",
      "description": "Spaced hyphens and line-start dashes become em dashes",
      "cases": [
        { "desc": "spaced hyphen between words", "input": "a - b", "expected": "a\u00A0\u2014 b", "lang": "en" },
        { "desc": "leading dash at line start", "input": "- word", "expected": "\u2014 word", "lang": "en" }
      ]
    },
    {
      "name": "numeric-range",
      "description": "Replaces hyphen between two numbers with an en-dash",
      "cases": [
        { "desc": "simple range", "input": "10-20", "expected": "10\u2060\u2013\u206020", "lang": "en" },
        { "desc": "open-ended range", "input": "2024-", "expected": "2024\u2060\u2013\u2060", "lang": "en" },
        { "desc": "larger range", "input": "200-800", "expected": "200\u2060\u2013\u2060800", "lang": "en" },
        { "desc": "open-ended range before a space (mid-sentence)", "input": "from 2024- on", "expected": "from 2024\u2060\u2013\u2060 on", "lang": "en" },
        { "desc": "number, hyphen, space, number is also read as open-ended (ambiguous, pinned as is)", "input": "5- 3", "expected": "5\u2060\u2013\u2060 3", "lang": "en" },
        { "desc": "number, hyphen, word is not a range", "input": "5-star", "expected": "5-star", "lang": "en" },
        { "desc": "number, hyphen, capital letter is not a range", "input": "3-D", "expected": "3-D", "lang": "en" }
      ]
    },
    {
      "name": "hyphen",
      "description": "Wraps hyphens in compound words with word joiners to prevent line breaks",
      "cases": [
        { "desc": "two-part compound", "input": "well-known", "expected": "well\u2060-\u2060known", "lang": "en" },
        { "desc": "three-part compound", "input": "editor-in-chief", "expected": "editor\u2060-\u2060in\u2060-\u2060chief", "lang": "en" }
      ]
    },
    {
      "name": "dash-shapes",
      "description": "Hyphen, dash and minus are chosen by whitespace shape and neighbor types; everything else is untouched",
      "cases": [
        { "desc": "double dash between words", "input": "a -- b", "expected": "a\u00A0\u2014 b", "lang": "en" },
        { "desc": "double dash without spaces", "input": "a--b", "expected": "a\u00A0\u2014 b", "lang": "en" },
        { "desc": "double dash before punctuation keeps the trailing space", "input": "you --.", "expected": "you\u00A0\u2014 .", "lang": "en" },
        { "desc": "spaced hyphen, word then currency", "input": "the price - 20USD", "expected": "the\u00A0price\u00A0\u2014 $\u202F20", "lang": "en" },
        { "desc": "line-start dash before number", "input": "- 5", "expected": "\u2014 5", "lang": "en" },
        { "desc": "spaced hyphen after number is ambiguous", "input": "5 - 3", "expected": "5 - 3", "lang": "en" },
        { "desc": "year span with spaces is ambiguous", "input": "1950 - 2000", "expected": "1950 - 2000", "lang": "en" },
        { "desc": "dash next to dash", "input": "x - - y", "expected": "x - - y", "lang": "en" },
        { "desc": "triple dash", "input": "x --- y", "expected": "x --- y", "lang": "en" },
        { "desc": "quadruple dash", "input": "----", "expected": "----", "lang": "en" },
        { "desc": "dash before punctuation", "input": "a - , b", "expected": "a\u00A0- , b", "lang": "en" },
        { "desc": "hyphen glued to the right word", "input": "a -b", "expected": "a\u00A0-b", "lang": "en" },
        { "desc": "hyphen glued to the left word", "input": "a- b", "expected": "a- b", "lang": "en" },
        { "desc": "spaced hyphen then unary minus", "input": "value - -20m", "expected": "value - \u221220m", "lang": "en" },
        { "desc": "minus before number", "input": "-20", "expected": "\u221220", "lang": "en" },
        { "desc": "minus before number then currency code", "input": "-20USD", "expected": "\u2212$\u202F20", "lang": "en" },
        { "desc": "minus before currency symbol", "input": "-$20", "expected": "\u2212$\u202F20", "lang": "en" },
        { "desc": "minus after whitespace", "input": "x -5", "expected": "x \u22125", "lang": "en" },
        { "desc": "minus after opening bracket", "input": "(-5)", "expected": "(\u22125)", "lang": "en" },
        { "desc": "minus before bracket stays in prose", "input": "-(5)", "expected": "-(5)", "lang": "en" },
        { "desc": "hyphen between word and number stays", "input": "a-5", "expected": "a-5", "lang": "en" },
        { "desc": "hyphen after merged ordinal", "input": "20th-century", "expected": "20\u1D57\u02B0\u2060-\u2060century", "lang": "en" },
        { "desc": "hyphen after merged temperature", "input": "20oC-warm", "expected": "20\u202F\u00B0C\u2060-\u2060warm", "lang": "en" }
      ]
    }
  ]
}
